rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection health check test collection
    match /test/{docId} {
      allow read: if true;
    }

    // Safety Alerts: operators and supervisors can read alerts. Authenticated users can create or resolve.
    match /safety_alerts/{alertId} {
      function isValidAlert(data) {
        return data.keys().hasAll(['workerId', 'alertType', 'timestamp', 'createdBy'])
          && data.workerId is string && data.workerId.size() <= 64
          && data.alertType in ['GAS_HAZARD', 'MAN_DOWN', 'NONE']
          && data.timestamp is number
          && data.createdBy is string
          && (data.createdBy == request.auth.uid || data.createdBy == 'system');
      }

      allow get: if isSignedIn() && isValidId(alertId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(alertId) && isValidAlert(incoming());
      allow update: if isSignedIn() && isValidId(alertId) && (existing().createdBy == request.auth.uid || request.auth != null);
      allow delete: if isSignedIn() && isValidId(alertId) && existing().createdBy == request.auth.uid;
    }

    // Voice Notes: supervisors transcribe emergency notes and field debriefs
    match /voice_notes/{noteId} {
      function isValidVoiceNote(data) {
        return data.keys().hasAll(['transcription', 'timestamp', 'authorId'])
          && data.transcription is string && data.transcription.size() <= 10000
          && data.timestamp is number
          && data.authorId is string && data.authorId == request.auth.uid;
      }

      allow get: if isSignedIn() && isValidId(noteId) && (existing().authorId == request.auth.uid || resource.data.authorId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(noteId) && isValidVoiceNote(incoming());
      allow update: if isSignedIn() && isValidId(noteId) && existing().authorId == request.auth.uid && isValidVoiceNote(incoming());
      allow delete: if isSignedIn() && isValidId(noteId) && existing().authorId == request.auth.uid;
    }

    // Chemical Hazard Cache: Read-only reference or updateable by signed in users
    match /chemical_hazards/{hazardId} {
      allow get: if isSignedIn() && isValidId(hazardId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(hazardId);
      allow delete: if false;
    }
  }
}
